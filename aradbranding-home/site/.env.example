# سامانه توسعه تجارت — copy to .env (outside public_html). Never commit .env.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://aradbranding.app
ASSET_URL=https://static.aradbranding.app
MEDIA_URL=https://media.aradbranding.app

# Generated by `php bin/console keys:generate` or the web installer
APP_KEY=
SIGNING_KEY=
HEALTH_TOKEN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PERSISTENT=false
# Phase 2: read replica
DB_READ_HOST=

SLOW_QUERY_MS=300
QUERY_BUDGET=8
LOG_LEVEL=info
SERVER_TIMING=true

CACHE_DRIVER=file
CACHE_PREFIX=sadt
SESSION_LIFETIME=1209600

# Comma-separated proxy/CDN IPs whose X-Forwarded-For is trusted
TRUSTED_PROXIES=

# Maximum size of an uploaded image (KB). Checked in the browser and on the server.
UPLOAD_MAX_KB=200

# Payments
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# Simulated gateway for testing the purchase flow. MUST be false in production.
PAYMENT_TEST_GATEWAY=false
