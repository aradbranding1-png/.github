# ------------------------------------------------------------------
# سامانه آموزش آراد برندینگ — فایل تنظیمات محیط
# این فایل را در پوشه اصلی پروژه (کنار app/ و public_html/) با نام .env ذخیره کنید.
# هرگز .env را داخل public_html قرار ندهید. سطح دسترسی پیشنهادی: 640
# نصب‌کننده تحت وب (index.php?r=/install) این فایل را به صورت خودکار می‌سازد.
# ------------------------------------------------------------------
APP_NAME=AradEdu
APP_ENV=production
APP_DEBUG=false
APP_URL=https://edu.aradbranding.me
# کلید تصادفی ۶۴ کاراکتری (نصب‌کننده خودکار می‌سازد)
APP_KEY=
APP_TIMEZONE=Asia/Tehran
# اگر mod_rewrite فعال است true، در غیر این صورت false (آدرس‌ها به شکل index.php?r=...)
APP_PRETTY_URLS=true

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_NAME=aradedu_sid
# دقیقه عدم فعالیت تا خروج خودکار
SESSION_LIFETIME=120
# اگر پشت Cloudflare/Proxy هستید IP پراکسی‌ها را با کاما وارد کنید
TRUSTED_PROXIES=

# --- SSO با my.aradbranding.me (مقادیر را تیم my ارائه می‌دهد) ---
# OAuth2:
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# JWT (HS256) — حداقل ۳۲ کاراکتر، مشترک با my:
SSO_SHARED_SECRET=
# کلید API سرور-به-سرور برای دریافت اطلاعات به‌روز کاربر از my (اختیاری):
MY_API_KEY=

# کلید عمومی Ed25519 برای بررسی امضای بسته‌های بروزرسانی (php cli.php keys:generate)
UPDATE_PUBLIC_KEY=
# کلید تصادفی داخلی
CRON_KEY=

# --- اتصال آراد کانتکت (اختیاری؛ بهتر است توکن از پنل تعریف شود) ---
ARAD_CONTACT_TOKEN=
